# Shawn Assistant — environment template. Copy to .env and fill in.

# Neon Postgres (required for jobs, rules, requests, verifications)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Company sign-in (shared internal credential)
SHAWN_LOGIN_EMAIL=you@company.com
SHAWN_LOGIN_PASSWORD=change-me
COMPANY_DOMAIN=company.com
AUTH_SECRET=random-long-string

# Google service account (JSON key contents, single line). Leave empty for DEMO_MODE.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"shawn@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Or set the email shown in access-request drafts:
SHAWN_SERVICE_ACCOUNT_EMAIL=shawn@project.iam.gserviceaccount.com

# Demo mode: no Google credentials needed, uses built-in sample data
DEMO_MODE=true

# Optional: AI interpretation of commands (deterministic parser always executes)
OPENAI_API_KEY=

# Optional: OmniRoute LLM gateway for ChatGPT-like conversational replies
# (OpenAI-compatible). Leave empty to use built-in replies.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Optional: authorized sender for access-request emails (copy-paste fallback otherwise)
EMAIL_SENDER=shawn@company.com
